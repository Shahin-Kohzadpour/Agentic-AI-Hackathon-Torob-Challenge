# Server-only settings. Configure actual values in Liara environment variables.
DATA_DIR=./data
TZ=Asia/Tehran
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
NESHAN_SERVICE_KEY=
# Optional alternate provider / vision-capable model:
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
VISION_MODEL=

# Optional explicit read-only catalogue file; runtime sets the versioned path.
# CATALOGUE_PATH=/app/data/catalogue-v3.db
